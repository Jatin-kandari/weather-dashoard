<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🌦️ Weather Dashboard</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>🌦️ Weather Dashboard</h1>
            <p class="subtitle">Get real-time weather for any city</p>
        </header>

        <div class="search-box">
            <input 
                type="text" 
                id="cityInput" 
                placeholder="Enter city name (e.g., London)"
                autocomplete="off"
            >
            <button id="searchBtn">Search</button>
        </div>

        <div id="errorMsg" class="error hidden"></div>

        <div id="loader" class="loader hidden">Loading...</div>

        <div id="weatherCard" class="weather-card hidden">
            <h2 id="cityName"></h2>
            <img id="weatherIcon" src="" alt="Weather icon">
            <p id="temperature" class="temp"></p>
            <p id="description"></p>
            <div class="details">
                <div class="detail-item">
                    <span class="label">💧 Humidity</span>
                    <span id="humidity" class="value"></span>
                </div>
                <div class="detail-item">
                    <span class="label">💨 Wind Speed</span>
                    <span id="windSpeed" class="value"></span>
                </div>
            </div>
        </div>
    </div>

    <script src="js/api.js"></script>
    <script src="js/main.js"></script>
</body>
</html>